# Required
FIRECRAWL_API_KEY=your_firecrawl_api_key  # Get from https://firecrawl.dev (Web scraping)

# =================================================================================
# SANDBOX PROVIDER - Cloudflare Sandboxes (Workers Paid)
# =================================================================================
SANDBOX_PROVIDER=cloudflare
# Public URL of this Worker. Local next dev must call the Worker, not Next.js.
CLOUDFLARE_SANDBOX_URL=https://code-market-builder.codemarket.workers.dev
# Same value as `npx wrangler secret put CLOUDFLARE_SANDBOX_SECRET`
CLOUDFLARE_SANDBOX_SECRET=your_cloudflare_sandbox_secret
# Server-side rollout gate for the durable launch orchestrator
LAUNCH_ORCHESTRATOR_V2_ENABLED=true
# Shared by the Worker and Next.js container so internal generation calls bypass the user login gate
BUILDER_INTERNAL_SECRET=your_builder_internal_secret
# Existing Code Market API used to exchange and verify Builder sessions
CODE_MARKET_API_ORIGIN=https://code.market
# Same PostHog project as code.market so both fronts are one analytics project
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Local Worker only: Next.js builder API origin
LAUNCH_BUILDER_ORIGIN=http://127.0.0.1:3000

# Optional fallback providers
# SANDBOX_PROVIDER=e2b
# E2B_API_KEY=your_e2b_api_key  # Get from https://e2b.dev
# SANDBOX_PROVIDER=vercel
# VERCEL_OIDC_TOKEN=auto_generated_by_vercel_env_pull

# =================================================================================
# AI PROVIDER - GetBlock Inference
# Docs: https://inference.eu-central-1.getblock.io/docs/v1
# =================================================================================
GETBLOCK_API_KEY=your_getblock_api_key
GETBLOCK_INFERENCE_BASE_URL=https://inference.eu-central-1.getblock.io

# Optional Morph Fast Apply
# Get yours at https://morphllm.com/
MORPH_API_KEY=your_fast_apply_key

# =================================================================================
# AI PROVIDER - GetBlock Inference
# Docs: https://inference.eu-central-1.getblock.io/docs/v1
# =================================================================================
GETBLOCK_API_KEY=your_getblock_api_key
GETBLOCK_INFERENCE_BASE_URL=https://inference.eu-central-1.getblock.io

# Optional Morph Fast Apply
# Get yours at https://morphllm.com/
MORPH_API_KEY=your_fast_apply_key
